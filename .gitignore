.benchmarks/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.ipynb_checkpoints/

.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov


# ------------------------------------------------------------------------------
