# ==============================================================================
#  Vectra — Geo-Distributed Vector Search & Transformer Inference Engine
#
#  This file enforces three repo invariants:
#    1. NOTHING DERIVED IS COMMITTED      build outputs, generated stubs,
#                                          caches, corpus, profiler captures
#    2. NOTHING THAT GATES CI IS IGNORED   regression goldens, harness sources
#    3. NO SECRET EVER ENTERS HISTORY      .env, keys, certs, local overrides
#
#  Ordering rules:
#    - Negations (!) MUST follow the rules they override (last match wins).
#    - Runtime-empty scaffolds are ignored via "dir/*" (contents), never
#      "dir/" (the directory) — git cannot re-include a file whose parent
#      directory is itself excluded. The trailing "!*.gitkeep" rule depends
#      on this form.
# ==============================================================================


# ------------------------------------------------------------------------------
#  Root build & packaging outputs
#  CMake/Ninja, `make dist`, and setuptools all land here. Contents are
#  ignored, not the directory, so the committed .gitkeep scaffold survives.
# ------------------------------------------------------------------------------
/build/*
/dist/


# ------------------------------------------------------------------------------
#  C++ / CMake / native toolchain
#  The canonical build location is /build/, but these names catch accidental
#  in-source CMake runs and compiler droppings anywhere in the tree.
#  NOTE: /Makefile is HAND-WRITTEN and committed — never ignore "Makefile".
#  NOTE: engine/cmake/*.cmake modules are committed source — never ignore
#        "*.cmake".
# ------------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
DartConfiguration.tcl
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.d
*.dSYM/

# gcov / clang profiling (coverage builds)
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
*.gmon.out

# ctags / gtags indexes (regenerated locally by editors)
tags
TAGS
GTAGS
GRTAGS
GPATH


# ------------------------------------------------------------------------------
#  Generated gRPC / protobuf stubs
#  Policy: stubs are ALWAYS regenerated by `make proto`, never committed,
#  never hand-edited. contracts/proto/*.proto is the single source of truth.
# ------------------------------------------------------------------------------
*_pb2.py
*_pb2.pyi
*_pb2_grpc.py
*_pb2_grpc.pyi
*.pb.cc
*.pb.h


