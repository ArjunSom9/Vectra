outputs/
multirun/
.hydra/


# ------------------------------------------------------------------------------
#  Data corpus — the 10M embeddings are path-managed, never committed
#  Contents ignored; committed .gitkeep survives via the trailing negation.
# ------------------------------------------------------------------------------
/data/corpus/*


# ------------------------------------------------------------------------------
#  Benchmark & profiler outputs
#  Harness SOURCES are committed; their OUTPUTS are not.
# ------------------------------------------------------------------------------
/benchmark/reports/*
/kernels/benchmarks/results/*

# Nsight Compute / Nsight Systems captures (the README.md in that directory
# documents the capture workflow and IS committed)
/kernels/benchmarks/nsight/*
!/kernels/benchmarks/nsight/README.md
*.ncu-rep
*.nsys-rep
*.qstrc

# Linux perf & valgrind (latency tuning sessions on the engine nodes)
perf.data
perf.data.old
callgrind.out.*
cachegrind.out.*
massif.out.*


# ------------------------------------------------------------------------------
#  Core dumps & bare-metal detritus — a low-latency C++ server WILL drop
#  cores in development; they must never reach the object store.
# ------------------------------------------------------------------------------
core
core.[0-9]*
*.core
vgcore.*
.nfs*


# ------------------------------------------------------------------------------
#  Secrets & local configuration — vault material, never history
#  Committed environments live in deploy/envs/*.yaml. Local overrides follow
#  the "*.local.yaml" convention and stay untracked.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
*.local.yaml
*.local.yml
*.local.json
docker-compose.override.yml


# ------------------------------------------------------------------------------
#  Docs site builds (docs-publish.yml output)
# ------------------------------------------------------------------------------
site/
book/


# ------------------------------------------------------------------------------
#  Editors & IDEs
#  .vscode/extensions.json is deliberately re-included (shared recommended-
#  extensions convention); everything else is per-developer.
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.code-workspace
.history/
*.swp
*.swo
*~
*.user
*.suo

# AI-assistant local state (CLAUDE.md and shared .claude/settings.json are
# committed; local settings are not)
.claude/settings.local.json


# ------------------------------------------------------------------------------
#  Provisioning transients (Ansible)
# ------------------------------------------------------------------------------
*.retry
.ansible/


# ------------------------------------------------------------------------------
#  Operating systems
# ------------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
 $RECYCLE.BIN/


# ------------------------------------------------------------------------------
#  Transient files
# ------------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*.log
logs/
*.pid


# ==============================================================================
#  INVARIANT NEGATIONS — these MUST be the last rules in the file
# ==============================================================================

# Invariant #1 support: every runtime-empty scaffold commits a .gitkeep
# (build/, dist/, data/corpus/, benchmark/reports/, kernels/benchmarks/
# results/, kernels/benchmarks/nsight/). This global rule keeps them all
# trackable; it works only because the directories above are ignored via
# "dir/*" contents, never "dir/" itself.
!*.gitkeep

# Invariant #2: regression goldens are CI CONTRACTS, not artifacts.
# They must never be captured by any benchmark/report rule, present or
# future — this negation documents that in executable form.
!/tests/regression/golden_*.json


# ==============================================================================
#  INTENTIONALLY COMMITTED — reference list (never add ignore rules for these)
#
#    contracts/proto/*.proto            interface source of truth
#    engine/cmake/*.cmake               build modules (source, not generated)
#    engine/configs/*.yaml              hnsw / geohash / shard / topology
#    models/training/configs/*.yaml     experiment configs (not *.local.yaml)
#    deploy/envs/*.yaml                 environment manifests
#    deploy/observability/.../*.json    Grafana dashboard definitions
#    tests/regression/golden_*.json     CI regression contracts
#    kernels/benchmarks/nsight/README.md
#    vendored hnswlib reference source  (recall oracle, never linked into
#                                        shipped binaries)
#    Makefile, CMakePresets.json, requirements-lock.txt, .editorconfig
#    CLAUDE.md, CONTRIBUTING.md, README.md, LICENSE, NOTICE, .gitignore
# ==============================================================================